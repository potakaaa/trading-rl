# Copy to .env and fill in. Never commit .env.

# OANDA practice (demo) account, v20 API
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# FRED (St. Louis Fed) API key, free: https://fredaccount.stlouisfed.org/apikeys
# Used only to build the historical news dataset.
FRED_API_KEY=

# Telegram bot (create with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord channel webhook URL
DISCORD_WEBHOOK_URL=

# Databento API key (optional, research data)
DATABENTO_API_KEY=
